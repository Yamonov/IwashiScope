// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = SpectraMate
PRODUCT_DISPLAY_NAME = SpectraMate
PRODUCT_BUNDLE_IDENTIFIER = com.yamonov.SpectraMate
MARKETING_VERSION = 0.9
CURRENT_PROJECT_VERSION = 15

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 14.6
ALWAYS_SEARCH_USER_PATHS = NO

// Compile all app and test targets in Swift 6 language mode with complete
// concurrency checking. The installed Xcode selects the concrete Swift 6.x
// compiler version.
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete

// Sparkle.framework and its helper executables are distributed pre-signed.
// Xcode cannot strip copied signed binaries without invalidating their signatures.
COPY_PHASE_STRIP = NO

// The spotread build phase compiles the bundled ArgyllCMS source tree.
ENABLE_USER_SCRIPT_SANDBOXING = NO

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = SpectraMate/Info.plist

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/SpectraMate.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/SpectraMate.entitlements
