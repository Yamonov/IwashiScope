// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = IwashiScope
PRODUCT_DISPLAY_NAME = IwashiScope
PRODUCT_BUNDLE_IDENTIFIER = com.yamonov.IwashiScope
MARKETING_VERSION = 0.9.5.2
CURRENT_PROJECT_VERSION = 28
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// ==========================================
// Code Signing
// ==========================================
// Official builds use the same Apple Developer team and automatic signing
// workflow as Scripta. Contributors can override DEVELOPMENT_TEAM from Xcode
// or the xcodebuild command line.
DEVELOPMENT_TEAM = 5NFE273M7M
CODE_SIGN_STYLE = Automatic

// IwashiScope launches the bundled measurement helper and accesses measurement
// hardware directly, so the App Sandbox is intentionally disabled.
ENABLE_APP_SANDBOX = NO

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 14.6
ALWAYS_SEARCH_USER_PATHS = NO
ARCHS = arm64 x86_64
ONLY_ACTIVE_ARCH = NO

// Compile all app and test targets in Swift 6 language mode with complete
// concurrency checking. The installed Xcode selects the concrete Swift 6.x
// compiler version.
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete

// Sparkle.framework and its helper executables are distributed pre-signed.
// Xcode cannot strip copied signed binaries without invalidating their signatures.
COPY_PHASE_STRIP = NO

// Resolve bundled dynamic frameworks such as Sparkle.framework at launch.
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks

// The spotread build phase compiles the bundled ArgyllCMS source tree.
ENABLE_USER_SCRIPT_SANDBOXING = NO

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = IwashiScope/Info.plist

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/IwashiScope.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/IwashiScope.entitlements
