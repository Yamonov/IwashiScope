                                                                   Style="{StaticResource MetricValue}" />
                                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding AdobeRgbGreenText}"
                                                                   Style="{StaticResource MetricValue}" />
                                                        <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding AdobeRgbBlueText}"
                                                                   Style="{StaticResource MetricValue}" />
                                                        <Control Grid.Row="3" Grid.Column="4"
                                                                 Template="{StaticResource GamutWarningIconTemplate}"
                                                                 ToolTip="{Binding AdobeGamutWarning}"
                                                                 AutomationProperties.HelpText="{Binding AdobeGamutWarning}"
                                                                 Visibility="{Binding HasAdobeGamutWarning, Converter={StaticResource BoolToVisibility}}" />

                                                        <TextBlock Grid.Row="4" Text="Display P3"
                                                                   Style="{StaticResource MetricLabel}" />
                                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DisplayP3RedText}"
                                                                   Style="{StaticResource MetricValue}" />
                                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding DisplayP3GreenText}"
                                                                   Style="{StaticResource MetricValue}" />
                                                        <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding DisplayP3BlueText}"
                                                                   Style="{StaticResource MetricValue}" />
                                                        <Control Grid.Row="4" Grid.Column="4"
                                                                 Template="{StaticResource GamutWarningIconTemplate}"
                                                                 ToolTip="{Binding DisplayP3GamutWarning}"
                                                                 AutomationProperties.HelpText="{Binding DisplayP3GamutWarning}"
                                                                 Visibility="{Binding HasDisplayP3GamutWarning, Converter={StaticResource BoolToVisibility}}" />
                                                    </Grid>
                                                </StackPanel>
                                                <Grid Margin="0,8,0,0"
                                                      Visibility="{Binding HasMonochrome, Converter={StaticResource BoolToVisibility}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="Y" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding MonochromeYText}"
                                                               Style="{StaticResource MetricValue}" />
                                                    <TextBlock Grid.Row="1" Text="L*" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MonochromeLText}"
                                                               Style="{StaticResource MetricValue}" />
                                                </Grid>
                                            </StackPanel>
                                        </GroupBox>

                                        <GroupBox Header="{Binding LightingInformationLabel}" Margin="0,10,0,0"
                                                  Visibility="{Binding HasLightingMetrics, Converter={StaticResource BoolToVisibility}}">
                                            <Grid Margin="8,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding IlluminanceLabel}" Style="{StaticResource MetricLabel}"
                                                           Visibility="{Binding HasLux, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LuxText}" Style="{StaticResource MetricValue}"
                                                           Visibility="{Binding HasLux, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Grid.Row="1" Text="CCT" Style="{StaticResource MetricLabel}"
                                                           Visibility="{Binding HasCct, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CctText}" Style="{StaticResource MetricValue}"
                                                           Visibility="{Binding HasCct, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Grid.Row="2" Text="Duv" Style="{StaticResource MetricLabel}"
                                                           Visibility="{Binding HasDuv, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DuvText}" Style="{StaticResource MetricValue}"
                                                           Visibility="{Binding HasDuv, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Grid.Row="3" Text="{Binding SuggestedEvLabel}" Style="{StaticResource MetricLabel}"
                                                           Visibility="{Binding HasEv, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EvText}" Style="{StaticResource MetricValue}"
                                                           Visibility="{Binding HasEv, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Grid.Row="4" Text="{Binding ClosestPlanckianLabel}" Style="{StaticResource MetricLabel}"
                                                           Visibility="{Binding HasClosestPlanckian, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ClosestPlanckianText}" Style="{StaticResource MetricValue}"
                                                           Visibility="{Binding HasClosestPlanckian, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Grid.Row="5" Text="{Binding ClosestDaylightLabel}" Style="{StaticResource MetricLabel}"
                                                           Visibility="{Binding HasClosestDaylight, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ClosestDaylightText}" Style="{StaticResource MetricValue}"
                                                           Visibility="{Binding HasClosestDaylight, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </GroupBox>

                                        <GroupBox Header="{Binding JspstGroupLabel}" Margin="0,10,0,0"
                                                  Visibility="{Binding ShowsStandardsEvaluation, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Margin="8,5">
                                                <TextBlock Text="{Binding JspstSummaryTitle}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding JspstSummaryDetail}" TextWrapping="Wrap"
                                                           FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"
                                                           Margin="0,3,0,6" />
                                                <Separator />
                                                <DockPanel Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding JspstCctLabel}" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding JspstCctText}" Style="{StaticResource MetricValue}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding JspstCctRequirement}" Style="{StaticResource RequirementText}" />
                                                <DockPanel Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding JspstChromaticityLabel}" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding JspstChromaticityText}" Style="{StaticResource MetricValue}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding JspstChromaticityRequirement}" Style="{StaticResource RequirementText}" />
                                                <DockPanel Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding AverageCriLabel}" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding JspstRaText}" Style="{StaticResource MetricValue}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding JspstRaRequirement}" Style="{StaticResource RequirementText}" />
                                                <DockPanel Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding MinimumRiLabel}" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding JspstMinimumRiText}" Style="{StaticResource MetricValue}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding JspstRiRequirement}" Style="{StaticResource RequirementText}" />
                                                <DockPanel Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding WorkSurfaceIlluminanceLabel}" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding JspstIlluminanceText}" Style="{StaticResource MetricValue}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding JspstIlluminanceRequirement}" Style="{StaticResource RequirementText}" />
                                            </StackPanel>
                                        </GroupBox>

                                        <GroupBox Header="{Binding IsoGroupLabel}" Margin="0,10,0,0"
                                                  Visibility="{Binding ShowsStandardsEvaluation, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Margin="8,5">
                                                <TextBlock Text="{Binding IsoSummaryTitle}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding IsoSummaryDetail}" TextWrapping="Wrap"
                                                           FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"
                                                           Margin="0,3,0,6" />
                                                <Separator />
                                                <DockPanel Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding IsoRfLabel}" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding IsoRfText}" Style="{StaticResource MetricValue}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding IsoRfRequirement}" Style="{StaticResource RequirementText}" />
                                                <DockPanel Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding AverageCriLabel}" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding IsoRaText}" Style="{StaticResource MetricValue}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding IsoRaRequirement}" Style="{StaticResource RequirementText}" />
                                                <DockPanel Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding P1P2Label}" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding NotAssessedLabel}" Style="{StaticResource MetricValue}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding UvUnavailableLabel}" Style="{StaticResource RequirementText}" />
                                                <DockPanel Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding P3P4Label}" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding IsoIlluminanceText}" Style="{StaticResource MetricValue}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding IsoIlluminanceRequirement}" Style="{StaticResource RequirementText}" />
                                            </StackPanel>
                                        </GroupBox>

                                        <GroupBox Header="{Binding RenderingGroupLabel}" Margin="0,10,0,0"
                                                  Visibility="{Binding HasCriOrTlci, Converter={StaticResource BoolToVisibility}}">
                                            <Grid Margin="8,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Ra" Style="{StaticResource MetricLabel}" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CriRaText}" Style="{StaticResource MetricValue}" />
                                                <TextBlock Grid.Row="1" Text="TLCI 2012 Qa" Style="{StaticResource MetricLabel}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TlciQaText}" Style="{StaticResource MetricValue}" />
                                            </Grid>
                                        </GroupBox>
                                    </StackPanel>
                                </ScrollViewer>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding HasActiveMeasurement, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="{Binding WaitingForValuesTitle}" FontSize="17"
                                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding WaitingForValuesDetail}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{Binding LogLabel}">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DebugStatusText}" FontWeight="SemiBold" />
                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock Text="モード" Width="38" FontSize="10"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding DebugModeText}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,2,0,0">
                                            <TextBlock Text="パス" Width="38" FontSize="10"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding DebugPathText}" FontSize="10"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <CheckBox x:Name="FollowLatestCheckBox"
                                                  Content="最新" IsChecked="True" />
                                        <Button Content="{Binding ClearLogLabel}"
                                                Command="{Binding ClearLogCommand}" Padding="8,4" />
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="SpotreadLogTextBox" Grid.Row="1" Margin="0,8,0,0"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                         IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" />
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <!-- MeasurementExportFooter.swift -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0" Padding="14,9,14,12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="{Binding ExportActionLabel}"
                                           FontWeight="SemiBold" FontSize="14" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding ExportSelectionText}"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </DockPanel>
                            <StackPanel Margin="0,6,0,0"
                                        Visibility="{Binding ShowsReflectanceExport, Converter={StaticResource BoolToVisibility}}">
                                <CheckBox x:Name="ExportAseCheckBox"
                                          Content="{Binding SwatchExportLabel}" IsChecked="True"
                                          IsEnabled="{Binding HasSelectedLab}" />
                                <CheckBox x:Name="ReflectanceSpectrumPngCheckBox"
                                          Content="{Binding SpectrumPngExportLabel}" IsChecked="False"
                                          IsEnabled="{Binding HasSelectedSpectrum}" />
                                <CheckBox x:Name="ReflectanceCsvCheckBox"
                                          Content="{Binding SpectrumCsvExportLabel}" IsChecked="False"
                                          IsEnabled="{Binding HasSelectedSpectrum}" />
                            </StackPanel>
                            <StackPanel Margin="0,6,0,0"
                                        Visibility="{Binding ShowsLightingExport, Converter={StaticResource BoolToVisibility}}">
                                <CheckBox x:Name="LightingSpectrumPngCheckBox"
                                          Content="{Binding SpectrumPngExportLabel}" IsChecked="True"
                                          IsEnabled="{Binding HasSelectedSpectrum}" />
                                <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                    <CheckBox x:Name="ExportD50CheckBox"
                                              Content="{Binding D50Label}" IsChecked="False" />
                                    <CheckBox x:Name="ExportD65CheckBox"
                                              Content="{Binding D65Label}" IsChecked="False" />
                                </StackPanel>
                                <CheckBox x:Name="ExportCriPngCheckBox"
                                          Content="{Binding CriPngExportLabel}" IsChecked="False"
                                          IsEnabled="{Binding HasSelectedCri}" />
                                <CheckBox x:Name="ExportTm30PngCheckBox"
                                          Content="{Binding Tm30PngExportLabel}" IsChecked="False"
                                          IsEnabled="{Binding HasSelectedTm30}" />
                                <CheckBox x:Name="LightingCsvCheckBox"
                                          Content="{Binding LightingCsvExportLabel}" IsChecked="False" />
                            </StackPanel>
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="{Binding ExportActionLabel}"
                                    IsEnabled="{Binding CanExportSelection}"
                                    Click="Export_Click" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Panel.ZIndex="100" Background="#99FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="120" Width="250" Height="250"
                    Padding="28">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="160" Height="5" IsIndeterminate="True" />
                    <TextBlock Text="{Binding StatusTitle}" FontSize="17"
                               FontWeight="SemiBold" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,15,0,0" />
                    <TextBlock Text="{Binding StatusDetail}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <Button Content="{Binding RestartLabel}"
                            Command="{Binding RestartCommand}" Padding="8,4"
                            Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
