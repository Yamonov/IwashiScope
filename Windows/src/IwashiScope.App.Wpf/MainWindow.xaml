                                                            <TextBlock Text="L*" FontSize="9"
                                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                                            <TextBlock Text="{Binding LabLText}" FontSize="10" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="a*" FontSize="9"
                                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                                            <TextBlock Text="{Binding LabAText}" FontSize="10" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="b*" FontSize="9"
                                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                                            <TextBlock Text="{Binding LabBText}" FontSize="10" />
                                                        </StackPanel>
                                                     </UniformGrid>
                                                     <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
