                                                <Border Padding="6,2" Margin="0,0,7,0"
                                                        Background="#E7F2FF" CornerRadius="8"
                                                        Visibility="{Binding HasAveragedMeasurement, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding AveragedMeasurementBadgeText}"
                                                               Foreground="#0A67C7" FontSize="10"
                                                               FontWeight="SemiBold" />
