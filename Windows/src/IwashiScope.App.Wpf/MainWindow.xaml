                                                             Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                             FontSize="11" Padding="3,1" Margin="5,1"
                                                             IsReadOnly="True"
                                                             IsHitTestVisible="{Binding CanRename}"
