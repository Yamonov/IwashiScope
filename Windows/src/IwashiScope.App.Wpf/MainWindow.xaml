                                                                         AutomationProperties.HelpText="{Binding LabChartAccessibilityValue}"
                                                                         Visibility="{Binding HasLab, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                                <StackPanel Margin="0,9,0,0"
                                                            Visibility="{Binding ShowsSrgbEncoding, Converter={StaticResource BoolToVisibility}}">
                                                    <Separator Margin="0,0,0,8" />
                                                    <TextBlock Text="{Binding RgbValuesLabel}"
                                                               FontSize="15" FontWeight="SemiBold" />
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="20" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
