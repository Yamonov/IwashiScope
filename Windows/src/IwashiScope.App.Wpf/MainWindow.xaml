                                                              Margin="{x:Static layout:HistoryCardLayout.ReflectanceNameMargin}"
                                                              Height="{x:Static layout:HistoryCardLayout.ReflectanceNameFieldHeight}"
                                                              FontSize="11" Padding="3,1"
                                                              IsReadOnly="True"
                                                              IsHitTestVisible="{Binding CanRename}"
