<Window x:Class="IwashiScope.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IwashiScope.App.Wpf.Controls"
        xmlns:layout="clr-namespace:IwashiScope.App.Wpf.Layout"
        xmlns:models="clr-namespace:IwashiScope.Core.Models;assembly=IwashiScope.Core"
        Title="{Binding WindowTitle}"
        Width="1280" Height="820" MinWidth="860" MinHeight="620"
        Icon="Resources/Icons/IwashiScope.ico"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <ControlTemplate x:Key="GamutWarningIconTemplate" TargetType="{x:Type Control}">
            <Viewbox Width="15" Height="15" Stretch="Uniform">
                <Grid Width="16" Height="14">
                    <Path Fill="#E5A900" Data="M 8,0 L 16,14 L 0,14 Z" />
                    <Path Fill="#332800"
                          Data="M 7.2,3.5 L 8.8,3.5 L 8.5,9.2 L 7.5,9.2 Z M 7.3,10.4 L 8.7,10.4 L 8.7,11.8 L 7.3,11.8 Z" />
                </Grid>
            </Viewbox>
        </ControlTemplate>
        <Style x:Key="RequirementText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ModeCardButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="MinHeight" Value="230" />
            <Setter Property="Margin" Value="9" />
            <Setter Property="Background" Value="#F8FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1">
            <MenuItem Header="{Binding FileLabel}">
                <MenuItem Header="{Binding OpenWorkspaceLabel}" InputGestureText="Ctrl+O"
                          Click="OpenWorkspace_Click" />
                <MenuItem Header="{Binding SaveWorkspaceLabel}" InputGestureText="Ctrl+S"
                          Click="SaveWorkspace_Click" />
                <Separator />
                <MenuItem Header="{Binding ExportLabel}" InputGestureText="Ctrl+E"
                          IsEnabled="{Binding CanExportSelection}" Click="Export_Click" />
            </MenuItem>
            <MenuItem Header="{Binding ViewLabel}">
                <MenuItem Header="{Binding JapaneseLabel}" Click="Japanese_Click" />
                <MenuItem Header="{Binding EnglishLabel}" Click="English_Click" />
            </MenuItem>
            <MenuItem Header="{Binding HelpLabel}">
                <MenuItem Header="{Binding LicensesAndSourceLabel}" Click="Licenses_Click" />
                <Separator />
                <MenuItem Header="{Binding CheckForUpdatesLabel}"
                          Click="CheckForUpdates_Click" />
            </MenuItem>
        </Menu>

        <!-- ModeSelectionView.swift -->
        <Grid Grid.Row="1"
              Visibility="{Binding IsModeSelectionVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#16007AC2" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="0.52" />
                    <GradientStop Color="#0F8A4BC0" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="40" HorizontalAlignment="Center"
                            VerticalAlignment="Center" MaxWidth="980">
                    <Image Source="Resources/Icons/IwashiScope-128.png"
                           Width="64" Height="64"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" />
                    <TextBlock Text="IwashiScope" FontSize="32" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock Text="Spectral &amp; Color Measurement" FontSize="18"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding ToolTagline}" FontSize="15"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding ModeSelectionTitle}" FontSize="21"
                               FontWeight="SemiBold" HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                    <TextBlock Text="{Binding ModeSelectionDetail}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" Margin="0,7,0,18" />

                    <UniformGrid Columns="3" MaxWidth="900">
                        <Button Style="{StaticResource ModeCardButton}"
                                AutomationProperties.AutomationId="mode-reflectance"
                                Command="{Binding ChangeModeCommand}"
                                CommandParameter="{x:Static models:MeasurementMode.Reflectance}">
                            <StackPanel>
                                <TextBlock Text="{Binding ReflectanceTitle}" FontSize="20"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ReflectanceSubtitle}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding ReflectanceDetail}" TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,14,0,0" />
                                <TextBlock Text="{Binding StartModeLabel}" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="0,22,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ModeCardButton}"
                                AutomationProperties.AutomationId="mode-ambient"
                                Command="{Binding ChangeModeCommand}"
                                CommandParameter="{x:Static models:MeasurementMode.Ambient}">
                            <StackPanel>
                                <TextBlock Text="{Binding AmbientTitle}" FontSize="20"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding AmbientSubtitle}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding AmbientDetail}" TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,14,0,0" />
                                <TextBlock Text="{Binding StartModeLabel}" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="0,22,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ModeCardButton}"
                                AutomationProperties.AutomationId="mode-emissive"
                                Command="{Binding ChangeModeCommand}"
                                CommandParameter="{x:Static models:MeasurementMode.Emissive}">
                            <StackPanel>
                                <TextBlock Text="{Binding EmissiveTitle}" FontSize="20"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding EmissiveSubtitle}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding EmissiveDetail}" TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,14,0,0" />
                                <TextBlock Text="{Binding StartModeLabel}" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="0,22,0,0" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,20,0,0">
                        <TextBlock Text="{Binding SpotreadAvailabilityText}"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- MeasurementWorkspaceView.swift -->
        <Grid Grid.Row="1"
              Visibility="{Binding IsWorkspaceVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="1" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource CanvasBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Content="{Binding ReturnToModeSelectionLabel}"
                        Command="{Binding ReturnToModeSelectionCommand}"
                        HorizontalAlignment="Left" Margin="18,12,0,8"
                        Padding="10,5" />

                <Grid x:Name="AnalysisHistoryGrid" Grid.Row="1" Margin="18,0,18,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="HistoryColumn" Width="360" MinWidth="180" MaxWidth="800" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,8">
                            <Border Style="{StaticResource CardBorder}" Padding="0"
                                    ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="400" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0"
                                                Visibility="{Binding ShowsReferenceControls, Converter={StaticResource BoolToVisibility}}">
                                        <DockPanel Margin="14,10,14,8">
                                            <TextBlock Text="{Binding ReferenceSpectrumLabel}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Margin="0,0,14,0" />
                                            <CheckBox Content="{Binding D50ReferenceLabel}"
                                                      IsChecked="{Binding ShowD50}" />
                                            <CheckBox Content="{Binding D65ReferenceLabel}"
                                                      IsChecked="{Binding ShowD65}" />
                                            <TextBlock Text="{Binding ReferenceNormalizationLabel}"
                                                       DockPanel.Dock="Right"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="10" />
                                        </DockPanel>
                                        <Separator />
                                    </StackPanel>
                                    <controls:SpectrumChart Grid.Row="1" Margin="4,0,7,7"
                                                            Measurement="{Binding ActiveMeasurement}"
                                                            UsePracticalRange="{Binding UsePracticalRange}"
                                                            ShowD50="{Binding ShowD50}"
                                                            ShowD65="{Binding ShowD65}"
                                                            YAxisConfiguration="{Binding YAxisConfiguration}"
                                                            MeasurementName="{Binding ActiveMeasurementName}" />
                                    <StackPanel Grid.Row="1" HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasActiveMeasurement, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Text="{Binding NoMeasurementTitle}"
                                                   FontSize="18" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding NoMeasurementDetail}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Margin="0,7,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0"
                                    Padding="12" ClipToBounds="True"
                                    Visibility="{Binding IsReflectance, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding IlluminantComparisonGroupLabel}"
                                               FontWeight="SemiBold" FontSize="14" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <RadioButton IsChecked="{Binding IsCieIlluminantSourceSelected}"
                                                     VerticalAlignment="Center" />
                                        <ComboBox ItemsSource="{Binding CieIlluminantOptions}"
                                                  SelectedItem="{Binding SelectedCieIlluminantOption}"
                                                  DisplayMemberPath="DisplayName"
                                                  IsEnabled="{Binding IsCieIlluminantSourceSelected}"
                                                  Width="225" Margin="4,0,10,0" />
                                        <RadioButton Content="{Binding UserDefined1Label}"
                                                     IsChecked="{Binding IsUser1IlluminantSourceSelected}"
                                                     IsEnabled="{Binding HasUser1Illuminant}" Margin="0,0,9,0" />
                                        <RadioButton Content="{Binding UserDefined2Label}"
                                                     IsChecked="{Binding IsUser2IlluminantSourceSelected}"
                                                     IsEnabled="{Binding HasUser2Illuminant}" Margin="0,0,9,0" />
                                        <RadioButton Content="{Binding UserDefined3Label}"
                                                     IsChecked="{Binding IsUser3IlluminantSourceSelected}"
                                                     IsEnabled="{Binding HasUser3Illuminant}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding UserIlluminantMetadataText}"
                                               FontSize="11" FontWeight="SemiBold" Margin="0,7,0,0"
                                               Visibility="{Binding ShowsUserIlluminantMetadata, Converter={StaticResource BoolToVisibility}}" />
                                    <Separator Margin="0,9" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Rectangle Width="25" Height="2" Fill="Black" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding MeasuredReflectanceLegendLabel}" Margin="5,0,13,0" />
                                        <Rectangle Width="25" Height="2" Fill="#FFB000" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedIlluminantLegendLabel}" Margin="5,0,13,0" />
                                        <Rectangle Width="25" Height="8" VerticalAlignment="Center">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                    <GradientStop Color="#5835E6" Offset="0" />
                                                    <GradientStop Color="#00C9E8" Offset="0.28" />
                                                    <GradientStop Color="#57DC32" Offset="0.48" />
                                                    <GradientStop Color="#FFE51C" Offset="0.62" />
                                                    <GradientStop Color="#FF5B14" Offset="0.78" />
                                                    <GradientStop Color="#A00008" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <TextBlock Text="{Binding ReflectedLightLegendLabel}" Margin="5,0,0,0" />
                                    </StackPanel>
                                    <controls:ReflectanceIlluminantChart Result="{Binding ReflectanceIlluminantResult}"
                                                                          Height="360" />
                                    <Separator Margin="0,9" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ColorAppearanceComparisonLabel}"
                                                   FontWeight="SemiBold" Margin="0,0,14,0" />
                                        <CheckBox Content="{Binding ApplyChromaticAdaptationLabel}"
                                                  IsChecked="{Binding AppliesChromaticAdaptation}" />
                                    </StackPanel>
                                    <Grid Margin="0,9,0,0"
                                          Visibility="{Binding HasReflectanceColorComparison, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding MeasuredD50Label}" FontWeight="SemiBold" />
                                            <Border Height="200" Background="{Binding MeasuredReflectancePatchBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="4" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="→" FontSize="28"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center" Margin="18,0" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding SimulatedPatchTitle}" FontWeight="SemiBold" />
                                            <Border Height="200" Background="{Binding SimulatedReflectancePatchBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="4" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="3" BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="5" Padding="14,10"
                                                Margin="14,22,0,0" VerticalAlignment="Stretch">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.ColumnSpan="2" Text="{Binding DifferenceAfterAdaptationLabel}"
                                                           FontWeight="SemiBold" Margin="0,0,0,7" />
                                                <TextBlock Grid.Row="1" Text="ΔE00" Margin="0,0,12,4" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeltaE00Text}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="2" Text="ΔE76" Margin="0,0,12,4" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeltaE76Text}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="3" Text="ΔL*" Margin="0,0,12,4" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DeltaLText}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="4" Text="Δa*" Margin="0,0,12,4" />
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DeltaAText}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="5" Text="Δb*" Margin="0,0,12,0" />
                                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DeltaBText}" FontWeight="SemiBold" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding ChromaticAdaptationExplanation}"
                                               FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" Margin="0,8,0,0"
                                               Visibility="{Binding HasReflectanceColorComparison, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding UvWarningText}" FontSize="10"
                                               Foreground="#E97818" TextWrapping="Wrap" Margin="0,7,0,0"
                                               Visibility="{Binding HasReflectanceIlluminantSelection, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,16,0,0"
                                        Visibility="{Binding ShowsLightingRenderingTabs, Converter={StaticResource BoolToVisibility}}">
                                <Border Style="{StaticResource CardBorder}" Padding="0"
                                        Height="330" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding RenderingGroupLabel}"
                                                   FontWeight="SemiBold" Margin="14,10,14,4" />
                                        <controls:CriChart Grid.Row="1" Margin="5,0,8,8"
                                                           Measurement="{Binding ActiveMeasurement}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Padding="0"
                                        Height="330" Margin="0,16,0,0" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="IES TM-30-15" FontWeight="SemiBold"
                                                   Margin="14,9,14,2" />
                                        <layout:Tm30ResponsivePanel Grid.Row="1" ClipToBounds="True">
                                            <Grid ClipToBounds="True">
                                                <controls:Tm30VectorChart Measurement="{Binding ActiveMeasurement}"
                                                                            ClipToBounds="True" />
                                                <TextBlock Text="{Binding Tm30VectorLegendText}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                           Margin="7" Padding="5,3" FontSize="9"
                                                           Background="#DFFFFFFF" />
                                            </Grid>
                                            <Border Padding="4" ClipToBounds="True">
                                                <StackPanel>
                                                    <TextBlock Text="Rf" Foreground="{StaticResource SecondaryTextBrush}" />
                                                    <TextBlock Text="{Binding Tm30RfText}" FontSize="22"
                                                               FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" />
                                                    <TextBlock Text="Rg" Foreground="{StaticResource SecondaryTextBrush}"
                                                               Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding Tm30RgText}" FontSize="22"
                                                               FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Tm30GuideOneText}" FontSize="9"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               TextWrapping="Wrap" Margin="0,5,0,0" />
                                                    <TextBlock Text="{Binding Tm30GuideTwoText}" FontSize="9"
                                                               Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Tm30CautionText}" FontSize="9"
                                                               Foreground="#B56C18" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <Grid ClipToBounds="True">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Tm30RfRgPlotLabel}"
                                                           FontWeight="SemiBold" FontSize="11" />
                                                <controls:RfRgChart Grid.Row="1" Measurement="{Binding ActiveMeasurement}"
                                                                   ClipToBounds="True" />
                                            </Grid>
                                            <Grid ClipToBounds="True">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Tm30SamplesLabel}"
                                                           FontWeight="SemiBold" FontSize="11" />
                                                <controls:Tm30SampleChart Grid.Row="1" Measurement="{Binding ActiveMeasurement}"
                                                                         ClipToBounds="True" />
                                            </Grid>
                                        </layout:Tm30ResponsivePanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                                  VerticalAlignment="Stretch" Background="Transparent"
                                  Cursor="SizeWE"
                                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

                    <Border Grid.Column="0" Background="#FAFCFD"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox x:Name="HistoryList" Grid.Row="0"
                                     ItemsSource="{Binding HistoryItems}"
                                     SelectionMode="Extended"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     BorderThickness="0" Background="Transparent"
                                     SelectionChanged="HistoryList_SelectionChanged"
                                     PreviewMouseLeftButtonDown="HistoryList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="HistoryList_PreviewMouseMove"
                                     AllowDrop="True" DragOver="HistoryList_DragOver"
                                     Drop="HistoryList_Drop">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.Panel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </GroupStyle.Panel>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GroupItem">
                                                            <Expander IsExpanded="True" Margin="4,5,4,8">
                                                                <Expander.Header>
                                                                    <TextBlock Text="{Binding Name}"
                                                                               Foreground="{StaticResource AccentBrush}"
                                                                               FontWeight="SemiBold" />
                                                                </Expander.Header>
                                                                <ItemsPresenter Margin="4,5,0,0" />
                                                            </Expander>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=OneWay}" />
                                        <Setter Property="Width" Value="{Binding ItemWidth}" />
                                        <Setter Property="Height" Value="{Binding ItemHeight}" />
                                        <Setter Property="Margin" Value="{x:Static layout:HistoryCardLayout.ItemMargin}" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="IsHitTestVisible" Value="{Binding CanSelect}" />
                                        <Setter Property="Focusable" Value="{Binding CanSelect}" />
                                        <Setter Property="VerticalAlignment" Value="Top" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding ItemWidth}" Height="{Binding ItemHeight}">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{Binding RenameLabel}"
                                                              Click="HistoryRenameMenu_Click" />
                                                    <Separator Visibility="{Binding IsLighting, Converter={StaticResource BoolToVisibility}}" />
                                                    <MenuItem Header="{Binding RegisterUserIlluminantLabel}"
                                                              Visibility="{Binding IsLighting, Converter={StaticResource BoolToVisibility}}">
                                                        <MenuItem Header="{Binding UserDefined1Label}" Tag="User1"
                                                                  Click="RegisterUserIlluminant_Click" />
                                                        <MenuItem Header="{Binding UserDefined2Label}" Tag="User2"
                                                                  Click="RegisterUserIlluminant_Click" />
                                                        <MenuItem Header="{Binding UserDefined3Label}" Tag="User3"
                                                                  Click="RegisterUserIlluminant_Click" />
                                                    </MenuItem>
                                                    <MenuItem Header="{Binding RemoveUserIlluminantLabel}"
                                                              IsEnabled="{Binding HasUserIlluminantRegistration}"
