                                                        <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                                                   Text="{Binding SrgbHex}"
                                                                   Style="{StaticResource MetricValue}" />

                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="R"
                                                                   Style="{StaticResource MetricLabel}"
                                                                   HorizontalAlignment="Right" />
                                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="G"
                                                                   Style="{StaticResource MetricLabel}"
                                                                   HorizontalAlignment="Right" />
                                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="B"
                                                                   Style="{StaticResource MetricLabel}"
                                                                   HorizontalAlignment="Right" />

                                                        <TextBlock Grid.Row="2" Text="sRGB"
                                                                   Style="{StaticResource MetricLabel}" />
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SrgbRedText}"
                                                                   Style="{StaticResource MetricValue}" />
                                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SrgbGreenText}"
                                                                   Style="{StaticResource MetricValue}" />
                                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SrgbBlueText}"
                                                                   Style="{StaticResource MetricValue}" />
