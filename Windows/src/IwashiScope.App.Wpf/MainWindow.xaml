                                                <TextBlock Grid.Row="1" Text="{Binding AveragedOutlierCountLabel}"
                                                           Style="{StaticResource MetricLabel}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AveragedOutlierCountText}"
                                                           Style="{StaticResource MetricValue}" />
                                                <TextBlock Grid.Row="2" Text="{Binding AveragedConvergenceLabel}"
                                                           Style="{StaticResource MetricLabel}" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AveragedConvergenceText}"
                                                           Style="{StaticResource MetricValue}" />
                                            </Grid>
                                        </GroupBox>

                                        <GroupBox Header="{Binding ColorimetricValuesLabel}" Margin="0,12,0,0">
                                            <StackPanel Margin="8,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="146" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                        <TextBlock Text="XYZ" FontSize="15" FontWeight="SemiBold" />
                                                        <UniformGrid Columns="3" Margin="0,4,0,8">
                                                            <StackPanel>
                                                                <TextBlock Text="X" Style="{StaticResource MetricLabel}" />
                                                                <TextBlock Text="{Binding XText}" FontFamily="Cascadia Mono, Consolas" />
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="Y" Style="{StaticResource MetricLabel}" />
                                                                <TextBlock Text="{Binding YText}" FontFamily="Cascadia Mono, Consolas" />
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="Z" Style="{StaticResource MetricLabel}" />
                                                                <TextBlock Text="{Binding ZText}" FontFamily="Cascadia Mono, Consolas" />
                                                            </StackPanel>
                                                        </UniformGrid>
                                                        <Separator />
                                                        <TextBlock Text="{Binding LabGroupLabel}" FontSize="15" FontWeight="SemiBold"
                                                                   Margin="0,8,0,0" />
                                                        <UniformGrid Columns="3" Margin="0,4,0,0">
                                                            <StackPanel>
                                                                <TextBlock Text="L*" Style="{StaticResource MetricLabel}" />
                                                                <TextBlock Text="{Binding LStarText}" FontFamily="Cascadia Mono, Consolas" />
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="a*" Style="{StaticResource MetricLabel}" />
                                                                <TextBlock Text="{Binding AStarText}" FontFamily="Cascadia Mono, Consolas" />
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="b*" Style="{StaticResource MetricLabel}" />
                                                                <TextBlock Text="{Binding BStarText}" FontFamily="Cascadia Mono, Consolas" />
                                                            </StackPanel>
                                                        </UniformGrid>
                                                        <StackPanel Visibility="{Binding ShowsMunsellValue, Converter={StaticResource BoolToVisibility}}">
                                                            <Separator Margin="0,9,0,7" />
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding MunsellValueLabel}"
                                                                           Style="{StaticResource MetricLabel}"
                                                                           Margin="0,0,8,0" />
                                                                <TextBlock Grid.Column="1" Text="{Binding MunsellValueText}"
                                                                           Style="{StaticResource MetricValue}" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding MunsellValuePremiseLabel}"
