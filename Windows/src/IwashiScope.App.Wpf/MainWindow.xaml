                                                        <RowDefinition Height="{x:Static layout:HistoryCardLayout.ReflectanceColorArea}" />
                                                        <RowDefinition Height="{x:Static layout:HistoryCardLayout.ReflectanceLabArea}" />
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" Background="{Binding SwatchBrush}" />
                                                    <UniformGrid Grid.Row="1" Columns="3" Margin="4,2">
