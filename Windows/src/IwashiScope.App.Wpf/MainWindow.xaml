                                                             LostKeyboardFocus="HistoryNameEditor_LostKeyboardFocus"
                                                             PreviewKeyDown="HistoryNameEditor_PreviewKeyDown" />
                                                </Grid>
                                            </Grid>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,4,3,0" Padding="6,2"
                                                    Background="#0A7DFF" CornerRadius="8"
                                                    Visibility="{Binding ShowsAverageBadge, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding AverageBadgeText}"
                                                           Foreground="White" FontSize="9"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding UserIlluminantBadgeTexts}"
                                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                                          Margin="3,4,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Vertical" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#B8000000" CornerRadius="8"
                                                                Padding="5,2" Margin="0,0,0,2">
                                                            <TextBlock Text="{Binding}" Foreground="White"
                                                                       FontSize="9" FontWeight="SemiBold" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="1" Margin="10,7,10,10">
                                <TextBlock Text="{Binding HistoryPersistenceError}"
                                           Foreground="#B33A2B" TextWrapping="Wrap"
                                           FontSize="10" Margin="0,0,0,5"
                                           Visibility="{Binding HasHistoryPersistenceError, Converter={StaticResource BoolToVisibility}}" />
