<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\IwashiScope.Core\IwashiScope.Core.csproj" />
    <ProjectReference Include="..\IwashiScope.Protocol\IwashiScope.Protocol.csproj" />
    <ProjectReference Include="..\IwashiScope.Infrastructure.Windows\IwashiScope.Infrastructure.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WinSparkle" Version="0.9.4"
                      GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IwashiScope.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>IwashiScope</AssemblyName>
    <RootNamespace>IwashiScope.App.Wpf</RootNamespace>
    <ApplicationIcon>Resources\Icons\IwashiScope.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\IwashiScope.ico" />
    <Resource Include="Resources\Icons\IwashiScope-128.png" />
    <Content Include="$(PkgWinSparkle)\runtimes\win-x64\native\WinSparkle.dll"
             Link="WinSparkle.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <EmbeddedResource Include="Resources\Localizable.xcstrings"
                      LogicalName="IwashiScope.Localizable.xcstrings" />
    <Content Include="..\..\..\LICENSE" Link="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\..\NOTICE" Link="NOTICE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\..\LICENSES\**\*" Link="LICENSES\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\..\ThirdParty\CIE\**\*" Link="ThirdParty\CIE\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(IwashiScopeHelperPath)"
             Link="iwashiscope-spotread.exe"
             Condition="'$(IwashiScopeHelperPath)' != '' and Exists('$(IwashiScopeHelperPath)')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="RequireIwashiScopeHelperForPublish"
          BeforeTargets="Publish"
          Condition="'$(IwashiScopeHelperPath)' == '' or !Exists('$(IwashiScopeHelperPath)')">
    <Error Text="Publish requires -p:IwashiScopeHelperPath=&lt;absolute path to iwashiscope-spotread.exe&gt;." />
  </Target>

</Project>
